{
  "name": "relaydesk",
  "version": "1.0.0",
  "private": true,
  "description": "A durable webhook delivery workbench with signed requests, crash recovery, and a React operations dashboard.",
  "type": "module",
  "engines": { "node": ">=24.0.0 <25" },
  "scripts": {
    "start": "node src/backend/server.js",
    "dev:api": "node --watch src/backend/server.js",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.js",
    "check": "npm run test && npm run build",
    "demo": "node tools/demo.mjs"
  },
  "dependencies": {
    "express": "5.3.0",
    "lucide-react": "1.65.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
